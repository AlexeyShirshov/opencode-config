{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "one-dark-pro",
    "mode": "dark"
  },
  "keybinds": {
    "app.exit": "ctrl+c,ctrl+d,<leader>q,<leader>й",
    "prompt.editor": "<leader>e,<leader>у",
    "theme.switch": "<leader>t,<leader>е",
    "session.sidebar.toggle": "<leader>b,<leader>и",
    "opencode.status": "<leader>s,<leader>ы",
    "session.export": "<leader>x,<leader>ч",
    "session.new": "<leader>n,<leader>т",
    "session.list": "<leader>l,<leader>д",
    "session.timeline": "<leader>g,<leader>п",
    "session.compact": "<leader>c,<leader>с",
    "model.list": "<leader>m,<leader>ь",
    "agent.list": "<leader>a,<leader>ф",
    "messages.copy": "<leader>y,<leader>н",
    "session.undo": "<leader>u,<leader>г",
    "session.redo": "<leader>r,<leader>к"
  },
  "plugins": [
    {
      "package": "./plugins/git-status",
      "options": {
        "interval": 2500
      }
    },
    "./plugins/sidebar-plugins",
    "./plugins/clear-session"
  ],
  "attention": {
    "enabled": true,
    // false/false — встроенный механизм V2 не используем: в WSL нет рабочих
    // PCM-устройств (`/dev/snd` — только `timer`, PulseAudio не поднят), а
    // miniaudio-движок TUI (`libasound.so.2`) печатает ошибки alsa-lib в stderr
    // того же терминала и ломает alternate screen.
    // Уведомления отданы плагину `wsl-notify` из npm (включён в `opencode.jsonc`).
    "notifications": false,
    "sound": false,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  // V2 по умолчанию держит табы в режиме "auto": внутри herdr (он выставляет
  // HERDR_ENV=1 в каждой панели) полоса сессий-табов скрывается. "on" включает
  // её всегда, в том числе когда opencode запущен из herdr.
  "tabs": {
    "mode": "on"
  },
  "animations": true
}
