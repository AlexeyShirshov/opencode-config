{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "pdca-dotnet: оркестратор и фазы цикла",
    "output": "pdca-dotnet.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-cycle",
        "label": "Цикл",
        "focus": [
          "plan",
          "do",
          "check",
          "act"
        ],
        "note": "PLAN → DO → CHECK → ACT по гейтам; go — начало DO."
      },
      {
        "id": "branches",
        "label": "Оркестратор и ветки",
        "focus": [
          "orb",
          "check",
          "sec_audit",
          "escalate",
          "stop"
        ],
        "note": "Оркестратор раскладывает вердикт: дефект → DO, план → PLAN; безопасность и эскалация — по триггеру."
      }
    ],
    "legend": {
      "entries": {
        "backend": {
          "label": "дешёвая ступень"
        },
        "security": {
          "label": "средняя ступень (medium)"
        },
        "external": {
          "label": "дорогая ступень (strong)"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "l_plan",
      "label": "PLAN"
    },
    {
      "id": "l_do",
      "label": "DO"
    },
    {
      "id": "l_check",
      "label": "CHECK"
    },
    {
      "id": "l_act",
      "label": "ACT / EXIT"
    },
    {
      "id": "l_ret",
      "label": "Оркестратор и ветки",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "plan",
    "do",
    "check",
    "act"
  ],
  "nodes": [
    {
      "id": "plan",
      "lane": "l_plan",
      "col": 0,
      "type": "security",
      "label": "PLAN",
      "sublabel": "дизайн · план → go",
      "width": 150
    },
    {
      "id": "do",
      "lane": "l_do",
      "col": 0,
      "type": "backend",
      "label": "DO",
      "sublabel": "код ∥ тесты ∥ доки",
      "width": 150
    },
    {
      "id": "check",
      "lane": "l_check",
      "col": 0,
      "type": "security",
      "label": "CHECK",
      "sublabel": "вердикт · аудит + линзы",
      "width": 150
    },
    {
      "id": "sec_audit",
      "lane": "l_check",
      "col": 1,
      "type": "security",
      "label": "Безопасность",
      "sublabel": "auth/секреты/ввод · medium",
      "width": 132
    },
    {
      "id": "act",
      "lane": "l_act",
      "col": 0,
      "type": "backend",
      "label": "ACT",
      "sublabel": "закрытие · handoff",
      "width": 150
    },
    {
      "id": "escalate",
      "lane": "l_ret",
      "col": 3,
      "type": "external",
      "label": "Эскалация",
      "sublabel": "повтор после 1 фикса · 3-й провал CHECK(r)",
      "width": 180
    },
    {
      "id": "orb",
      "lane": "l_ret",
      "col": 2,
      "type": "backend",
      "label": "Оркестратор",
      "sublabel": "build · диспетчер",
      "width": 120
    },
    {
      "id": "stop",
      "lane": "l_ret",
      "col": 4,
      "type": "external",
      "label": "STOP",
      "sublabel": "с записью статуса",
      "width": 92
    }
  ],
  "edges": [
    {
      "id": "e_do_check",
      "from": "do",
      "to": "check",
      "label": "потоки закрыты",
      "role": "main"
    },
    {
      "id": "e_sec_audit",
      "from": "check",
      "to": "sec_audit",
      "label": "если auth / секреты / ввод",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e_lenses",
      "from": "check",
      "to": "act",
      "label": "аудит + линзы зелёные"
    },
    {
      "id": "e_go",
      "from": "plan",
      "to": "do",
      "label": "`go` · n=1 / авто: сразу"
    },
    {
      "id": "e_check_orb",
      "from": "check",
      "to": "orb",
      "label": "вердикт pass/fail",
      "role": "return"
    },
    {
      "id": "e_escalate_orb",
      "from": "escalate",
      "to": "orb",
      "label": "рекомендация",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "e_orb_do",
      "from": "orb",
      "to": "do",
      "label": "исправимо → DO",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "e_orb_act",
      "from": "orb",
      "to": "act",
      "label": "принять риск",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "e_orb_stop",
      "from": "orb",
      "to": "stop",
      "label": "не исправимо"
    },
    {
      "id": "e_orb_escalate",
      "from": "orb",
      "to": "escalate",
      "label": "повтор дефекта / 3-й провал r",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e_orb_replan",
      "from": "orb",
      "to": "plan",
      "label": "неверный план · r+1",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "e_do_replan",
      "from": "do",
      "to": "plan",
      "label": "новое предусловие / блокер",
      "variant": "security",
      "role": "return"
    }
  ]
}