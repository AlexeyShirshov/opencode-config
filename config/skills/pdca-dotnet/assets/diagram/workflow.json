          "do",
          "code",
          "tests",
          "docs",
          "check",
          "audit",
          "lens_tests",
          "lens_docs",
          "lens_perf",
          "sec_audit"
        ],
        "note": "DO: код∥тесты∥доки; CHECK: аудит∥тест∥док∥перф∥(безопасность*). Ветки независимы; независимые фичи — отдельные циклы/сессии."
      },
      {
        "id": "act-close",
        "label": "ACT: закрытие цикла",
        "focus": [
          "act",
          "act_lesson",
          "act_docs",
          "act_rules",
          "act_status",
          "act_handoff"
        ],
        "note": "Шаги ACT по порядку: урок → memory, доки/AGENTS.md, правила, статус-файл, handoff (последним)."
      },
      {
        "id": "returns",
        "label": "Возвраты и эскалация",
        "focus": [
          "check",
          "replan",
          "plan",
          "do",
          "escalate"
        ],
        "note": "Дефект → DO, неверный план → PLAN; эскалация — по триггерам."
      }
