{
  "$schema": "https://opencode.ai/config.json",
  // Уведомления — плагин Windows Toast `wsl-notify` **из npm** (канонический
  // источник — `AlexeyShirshov/skills:opencode/plugins/wsl-notify`; локальной
  // копии в `plugins/` больше нет). Встроенный V2-механизм (`cli.json` →
  // `attention`) держим выключенным: его звук в WSL падает в alsa-lib и сыпет
  // ошибки в терминал TUI.
  // Настройки (нужны редко, дефолты рабочие) — объектной формой:
  // { "package": "wsl-notify", "options": { "graceMs": 500, "minTurnMs": 500 } }.
  // Отключить плагин обратно — директивой `-wsl-notify`.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "wsl-notify",
    "opencode-roslyn"
  ],
  "agents": {
    // `plan` (встроенный primary) — как `architect`: default-deny.
    // `*` запрещает всё, включая любой MCP (`<server>_<tool>`) и
    // read/grep/glob/shell/edit/webfetch/websearch; ниже — разрешения.
    // Факты — через `scout`, правки — через `coder`; `general`/`explore` запрещены.
    "plan": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" },
        // `brainstorming` (superpowers) — только `architect` (см. топ-левел `permissions`).
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "brainstorming", "effect": "deny" }
      ]
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "/mnt/c/Users/user/source/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/mnt/c/Users/user/Pictures/Screenshots/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    // Курируемый dotnet-набор + полный пак скиллов: невыбранные скиллы читаются
    // по требованию напрямую из пака (`.config/opencode/skills-deepseek/<name>/SKILL.md`).
    { "action": "external_directory", "resource": "~/.config/opencode/skills-deepseek/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills-deepseek-curated/**", "effect": "allow" },
    // Весь глобальный конфиг opencode: `AGENTS.md`, скиллы `skills/pdca-*`,
    // `agents/`, `profiles/`. Субагенты (`scout`/`coder`/`pdca-*`) читают их при
    // сборе фактов — иначе каждый такой `read` уходит в `ask` и подвешивает
    // автономный PDCA-цикл (наблюдалось в автономной сессии). Секреты — исключены.
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    // Системные пути и корни соседних репозиториев: агенты читают их при сборе
    // фактов и сборке. Дефолт `ask` вешает автономный цикл на каждом таком чтении
    // (напр. `cat /etc/timezone` при сборе фактов), поэтому разрешаем их явно.
    { "action": "external_directory", "resource": "/etc/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/proc/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/snap/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/sys/**", "effect": "allow" },
    // `/dev/*`: `dotnet run` интеграционных тестов (podman/WSL) дёргает спец-узлы
    // (`/dev/tty`, `/dev/null`); дефолт `ask` вешал прогон интеграционных тестов.
    { "action": "external_directory", "resource": "/dev/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/alex/sources/**", "effect": "allow" },
    // Coverage/benchmark-отчёты рядом с репо (`dotnet test` кладёт их в
    // `/home/alex/tests/coverage/report`): subagent `coder` уходил в ask на этом
    // пути и вешал цикл. Секретов нет.
    { "action": "external_directory", "resource": "/home/alex/tests/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/mnt/c/Users/user/**", "effect": "allow" },
    // Собственные логи/tool-output opencode: агенты читают их для провенанса
    // сессии (напр. `scout` грепал `opencode.log` для провенанса). Без allow — `ask` и
    // стоп. Только эти подкаталоги: `auth.json`, `*.db`, `snapshot/` — под ask.
    { "action": "external_directory", "resource": "/home/alex/.local/share/opencode/log/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/alex/.local/share/opencode/tool-output/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/alex/.local/share/opencode/zen-cache-proxy.log", "effect": "allow" },
    // State opencode (model.json, plugin-meta.json, prompt-history.jsonl и т.п.):
    // агенты грепают его для провенанса (напр. `scout` искал имена скиллов).
    // Секретов там нет.
    { "action": "external_directory", "resource": "/home/alex/.local/state/opencode/**", "effect": "allow" },
    // Runtime пользователя и VS Code: агенты читают конфиги/расширения при сборе
    // фактов (тоже стреляло в ask — см. /run/user/1000, .vscode-server, Code/User).
    { "action": "external_directory", "resource": "/run/user/1000/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/alex/.vscode-server/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/mnt/c/Users/user/AppData/Roaming/Code/User/**", "effect": "allow" },
    // Кэш NuGet: агенты читают `.xml`/метаданные пакетов (напр. Npgsql) при сборе
    // фактов — дефолт `ask` вешал subagent `coder`. Секретов нет.
    { "action": "external_directory", "resource": "~/.nuget/packages/**", "effect": "allow" },
    // Секреты и ключи — вне доступа (последнее совпавшее правило выигрывает).
    { "action": "external_directory", "resource": "~/.config/opencode/secrets.env", "effect": "deny" },
    { "action": "external_directory", "resource": "/mnt/c/Users/user/.ssh/**", "effect": "deny" },
    // `brainstorming` виден только `architect`: глобально запрещён, а architect
    // перекрывает это своим `skill: allow` (правила агента идут после глобальных).
    // Прочие агенты, у кого `skill: allow`, дополнительно глушат его у себя.
    { "action": "skill", "resource": "brainstorming", "effect": "deny" }
  ]
}
