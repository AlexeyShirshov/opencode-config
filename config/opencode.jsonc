{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "csharp": {
      "command": [
        "/home/alex/.dotnet/tools/roslyn-language-server",
        "--stdio",
        "--autoLoadProjects"
      ],
      "env": {
        "DOTNET_ROOT": "/home/alex/.dotnet"
      }
    }
  },
  "permission": {
    "external_directory": {
      "/mnt/c/Users/user/source/**": "allow"
    }
  }
}
