{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["blue", "purple", "green", "yellow", "orange", "red", "cyan"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.500",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.red.200",
          "$disabled": "$hue.neutral.500"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.500",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.orange.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.blue.200" }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "#2c313c",
        "max": "#3e4452"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "#2c313c",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$hue.neutral.900" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#181a1f" },
    "scrollbar": { "base": "#4e5666" },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.blue.200"
      },
      "background": {
        "added": "#2c382b",
        "removed": "#3a2d2f",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#aad482",
        "removed": "#e8828b"
      },
      "lineNumber": {
        "text": "#495162",
        "background": {
          "added": "#283427",
          "removed": "#36292b"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.red.200",
      "link": "$hue.blue.200",
      "linkText": "$hue.blue.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.500",
      "emphasis": "$hue.purple.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.yellow.200",
      "listEnumeration": "$hue.yellow.200",
      "image": "$hue.blue.200",
      "imageText": "$hue.purple.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.high" }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#d7dae0",
        "200": "#abb2bf",
        "300": "#828997",
        "400": "#7f848e",
        "500": "#5c6370",
        "600": "#2c313c",
        "700": "#21252b",
        "800": "#282c34",
        "900": "#1d1f23"
      },
      "red": {
        "100": "#fd7e87",
        "200": "#e06c75",
        "300": "#c35a63",
        "400": "#a74952",
        "500": "#8c3941",
        "600": "#722931",
        "700": "#591921",
        "800": "#410a13",
        "900": "#280207"
      },
      "orange": {
        "100": "#eeb179",
        "200": "#d19a66",
        "300": "#b58354",
        "400": "#996d42",
        "500": "#7f5831",
        "600": "#654321",
        "700": "#4d2f11",
        "800": "#351d03",
        "900": "#1d0d01"
      },
      "yellow": {
        "100": "#fde0aa",
        "200": "#e5c07b",
        "300": "#c5a365",
        "400": "#a5884f",
        "500": "#876d3a",
        "600": "#6a5326",
        "700": "#4e3b12",
        "800": "#342401",
        "900": "#191001"
      },
      "green": {
        "100": "#b0df8e",
        "200": "#98c379",
        "300": "#81a764",
        "400": "#6a8c50",
        "500": "#54723d",
        "600": "#3f5a2a",
        "700": "#2b4218",
        "800": "#182b07",
        "900": "#081600"
      },
      "cyan": {
        "100": "#68d0dd",
        "200": "#56b6c2",
        "300": "#449da7",
        "400": "#33848e",
        "500": "#226c75",
        "600": "#0f555d",
        "700": "#093e44",
        "800": "#02292e",
        "900": "#001518"
      },
      "blue": {
        "100": "#8cc7fa",
        "200": "#61afef",
        "300": "#4f96d0",
        "400": "#3d7eb2",
        "500": "#2c6694",
        "600": "#1b5078",
        "700": "#093a5d",
        "800": "#022640",
        "900": "#001324"
      },
      "purple": {
        "100": "#e18cfa",
        "200": "#c678dd",
        "300": "#ac65c0",
        "400": "#9252a5",
        "500": "#79408a",
        "600": "#612f6f",
        "700": "#4a1e56",
        "800": "#340e3f",
        "900": "#200128"
      },
      "accent": "$hue.cyan",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
