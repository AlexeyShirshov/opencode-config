#!/bin/sh
# opencode push guard + source-drift gate.
#
# 1) Drift gate (AGENTS.md §Источник истины): in a repo that vendors skills/plugins
#    (has config/tools/vendor-skills.mjs and a ../skills checkout), refuse to push
#    while the snapshot differs from the committed, pushed skills repo.
# 2) Agent-push guard: a non-interactive (agent/cycle) push is blocked; the user
#    pushes manually. Override a single push: GIT_ALLOW_PUSH=1 git push ...
#
# Enable (all repos):  git config --global core.hooksPath ~/.config/opencode/git-hooks
# Per repo:            cp ~/.config/opencode/git-hooks/pre-push .git/hooks/pre-push

set -u

[ "${GIT_ALLOW_PUSH:-}" = "1" ] && exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# --- 0) host contract (agents/profiles/AGENTS.md/README, no project specifics) --
if [ -f "$root/config/tools/check-host-contract.mjs" ] && command -v bun >/dev/null 2>&1; then
  if ! (cd "$root" && bun config/tools/check-host-contract.mjs); then
    echo "pre-push: BLOCKED — host contract is broken (see above)." >&2
    exit 1
  fi
fi

# --- 1) skills/plugins snapshot must match the source -----------------------
if [ -f "$root/config/tools/vendor-skills.mjs" ] && [ -d "$root/../skills" ]; then
  if command -v bun >/dev/null 2>&1; then
    if ! (cd "$root" && bun config/tools/vendor-skills.mjs --check); then
      echo "pre-push: BLOCKED — skills/plugins snapshot drifted from the skills repo." >&2
      echo "  Fix the source in ../skills (test, commit, push), then:" >&2
      echo "    bun config/tools/vendor-skills.mjs --fix" >&2
      echo "    git add -A && git commit" >&2
      exit 1
    fi
  else
    echo "pre-push: bun not found — vendor-skills gate SKIPPED" >&2
  fi
fi

# --- 2) the agent/cycle must not push --------------------------------------
# A human at a terminal has a controlling tty; the agent/cycle does not.
if [ -t 0 ] || [ -t 2 ]; then
  exit 0
fi

echo "pre-push: BLOCKED — non-interactive push (agent/cycle context)." >&2
echo "  The cycle must not push (AGENTS.md 'Git', the user pushes manually)." >&2
echo "  Push from your shell, or override with: GIT_ALLOW_PUSH=1 git push ..." >&2
exit 1
