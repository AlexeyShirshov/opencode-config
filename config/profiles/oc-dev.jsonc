{
  "$schema": "https://opencode.ai/config.json",

  // ── «Мозг»: сильная модель для основного агента (Plan/Check). ──────────────
  // Всё остальное (субагенты) переопределено ниже на DeepSeek Flash.
  "model": "opencode/claude-opus-5-5",

  // Дешёвая модель для служебных задач (генерация заголовков/резюме).
  "small_model": "deepseek/deepseek-flash",

  // Стартуем с Plan (Opus) → Tab → build (Opus) = оркестратор PDCA → coder (DeepSeek).
  "default_agent": "plan",

  // Профильные правила: контракт PDCA (фазы/gate'ы/todo), делегирование, Plan → Build.
  "instructions": [
    "/home/alex/.config/opencode/profiles/oc-dev.instructions.md"
  ],

  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-deepseek"
    ]
  },

  "provider": {
    "opencode": {
      "options": {
        // Opus 5.5 долго рассуждает — запас по чанку больше, чем у DeepSeek.
        "headerTimeout": 60000,
        "chunkTimeout": 300000,
        // Локальный zen-cache-proxy добавляет cache_control.ttl="1h" (иначе 5 мин):
        // оркестратор не теряет prompt-cache, пока ждёт субагентов → нет дорогих
        // перезаписей контекста. Поднимается из алиаса oc-dev; см. tools/zen-cache-proxy.mjs.
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    }
  },

  "agent": {
    // ── «Мозг» ────────────────────────────────────────────────────────────────
    // build: оркестратор PDCA (Opus). Лимит шагов — на весь цикл с запасом на один
    // loop-back; объём работы уходит субагентам (coder/explore/general).
    "build": {
      "model": "opencode/claude-opus-5-5",
      "steps": 60
    },

    // plan: Opus, архитектура и декомпозиция.
    "plan": {
      "model": "opencode/claude-opus-5-5"
    },

    // ── «Руки»: coder ─────────────────────────────────────────────────────────
    // Субагент-исполнитель на дешёвой модели с правом править и запускать.
    "coder": {
      "mode": "subagent",
      "description": "Исполнитель на дешёвой модели DeepSeek. Пишет и правит код, запускает команды. Use for the Do-phase: applying a plan, generating code/tests, bug fixes, refactoring — anything that changes files or runs shells.",
      "model": "deepseek/deepseek-flash",
      "steps": 60,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": {
          "/mnt/c/Users/user/source/**": "allow",
          "/mnt/c/Users/user/Pictures/Screenshots/**": "allow",
          "/tmp/**": "allow"
        }
      },
      "prompt": "Ты — исполнитель («руки») основного агента. Получаешь конкретную задачу и выполняешь её через edit/write/bash. Не переисследуй кодовую базу заново и не переписывай план: если данных не хватает — верни короткий вопрос, а не догадку. Делай минимально достаточные правки. В ответ возвращай только итог: какие файлы изменены, результат сборки/тестов, оставшиеся вопросы."
    },

    // ── Остальные субагенты: DeepSeek Flash (изолированный контекст). ─────────
    "general": { "model": "deepseek/deepseek-flash" },
    "explore": { "model": "deepseek/deepseek-flash" },
    "compaction": { "model": "deepseek/deepseek-flash" },
    "title": { "model": "deepseek/deepseek-flash" },
    "summary": { "model": "deepseek/deepseek-flash" },

    // ── .NET-специалисты: DeepSeek Flash, кроме security-аудита. ────────────
    // code-review — gather Check-этапа на DeepSeek (сводку триажит build/Opus);
    // security-reviewer — точечно, оставлен на Opus.
    "docfx-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-architect": { "model": "deepseek/deepseek-flash" },
    "dotnet-aspnetcore-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-async-performance-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-benchmark-designer": { "model": "deepseek/deepseek-flash" },
    "dotnet-blazor-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-cloud-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-code-review-agent": { "model": "deepseek/deepseek-flash" },
    "dotnet-concurrency-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-csharp-concurrency-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-docs-generator": { "model": "deepseek/deepseek-flash" },
    "dotnet-maui-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-performance-analyst": { "model": "deepseek/deepseek-flash" },
    "dotnet-security-reviewer": { "model": "opencode/claude-opus-5-5" },
    "dotnet-testing-specialist": { "model": "deepseek/deepseek-flash" },
    "dotnet-uno-specialist": { "model": "deepseek/deepseek-flash" }
  },

  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "/home/alex/.bun/bin/bun",
        "x",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/home/alex/.local/share/opencode/memory.json"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "mslearn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs",
      "enabled": true
    }
  }
}
