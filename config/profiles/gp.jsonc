{
  "$schema": "https://opencode.ai/config.json",
  // Вложенные субагенты. Дефолт 1 не даёт субагенту делегировать; в oc-ds это
  // блокирует `pdca-orchestrator`, поэтому глубина 3 (V2 читает её только из
  // `experimental`; top-level `subagent_depth` отбрасывается с WARN). В oc-gp
  // PDCA нет, но глубина оставлена, чтобы не ломать вложенные не-PDCA сценарии.
  "experimental": {
    "subagent_depth": 3
  },
  "model": "opencode-go/beam-free",
  "small_model": "openai/gpt-6-luna",
  // PDCA — только в oc-ds. Скиллы семейства лежат в общем `skills/`, поэтому здесь
  // они закрыты правами (`deny` скрывает их из списка модели и запрещает загрузку),
  // а запуск PDCA-ролей дополнительно запрещён: у `pdca-orchestrator` собственный
  // `skill: "*": allow` идёт позже правил профиля.
  "permissions": [
    { "action": "skill", "resource": "pdca", "effect": "deny" },
    { "action": "skill", "resource": "pdca-*", "effect": "deny" },
    { "action": "subagent", "resource": "pdca-*", "effect": "deny" }
  ],
  // ── Привязка ролей: модель профиля (`model`) действует на дефолтного агента (`build`,
  // `plan` и всё, что не имеет явной привязки); роли ниже привязаны отдельно и её не
  // наследуют. PDCA-ролей в oc-gp нет; остальные привязки совпадают с oc-ds.
  // Проект может переопределить роль своим `.opencode/opencode.jsonc`
  // (проектный конфиг мержится после профиля).
  "agent": {
    "architect": { "model": "openai/gpt-6-astra" },
    "coder": { "model": "openai/gpt-6-luna", "variant": "max" },
    "scout": { "model": "openai/gpt-6-luna" }
  },
  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-gp"
    ]
  },
  "provider": {
    "opencode-go": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    },
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 300000
      }
    }
  }
}
