{
  "$schema": "https://opencode.ai/config.json",
  // Вложенные субагенты (primary → pdca-orchestrator → роли). Дефолт 1 блокирует `pdca-orchestrator`. Нужен перезапуск.
  // V2: глубина живёт в `experimental.subagent_depth` — top-level `subagent_depth` V2 отбрасывает
  // с WARN (`omitted unsupported legacy setting`), и субагент теряет право делегировать (глубина = 1).
  "experimental": {
    "subagent_depth": 3
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  // ── Привязка ролей: модель профиля (`model`) действует на дефолтного агента (`build`,
  // `plan` и всё, что не имеет явной привязки); роли ниже привязаны отдельно и её не
  // наследуют. У oc-gp нет отдельного провайдера medium/strong-тира, поэтому роли делят
  // одну модель. Проект может переопределить роль своим `.opencode/opencode.jsonc`
  // (проектный конфиг мержится после профиля).
  "agent": {
    "pdca-planner": { "model": "opencode-go/kimi-k3" },
    "pdca-check": { "model": "opencode-go/kimi-k3" },
    "pdca-escalate": { "model": "opencode-go/kimi-k3" },
    "pdca-executor": { "model": "opencode-go/kimi-k3" },
    "architect": { "model": "opencode-go/kimi-k3" },
    "planner": { "model": "opencode-go/kimi-k3" },
    "check": { "model": "opencode-go/kimi-k3" },
    "escalate": { "model": "opencode-go/kimi-k3" },
    "security-auditor": { "model": "opencode-go/kimi-k3" },
    "coder": { "model": "opencode-go/kimi-k3" },
    "scout": { "model": "opencode-go/kimi-k3" },
    "btw": { "model": "opencode-go/kimi-k3" },
    "pdca-orchestrator": { "model": "opencode-go/kimi-k3" }
  },
  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-gp"
    ]
  },
  "provider": {
    "opencode-go": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    },
    "openrouter": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      },
      "models": {
        "moonshotai/kimi-k2.6": {
          "limit": { "context": 262144, "output": 8192 }
        },
        "google/gemini-3.8-flash": {
          "limit": { "context": 1048576, "output": 8192 }
        }
      }
    }
  }
}
