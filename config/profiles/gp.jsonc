{
  "$schema": "https://opencode.ai/config.json",
  // Вложенные субагенты (primary → lane → роли). Дефолт 1 блокирует `lane`. Нужен перезапуск.
  "subagent_depth": 3,
  "model": "opencode-go/kimi-k3",
  // ── Привязка ролей: одномодельный хост. У oc-gp нет провайдера medium/strong-тира,
  // поэтому все роли идут на единственную модель профиля (её id — в блоке ниже и в
  // `model`). Проект может переопределить роль своим `.opencode/opencode.jsonc`
  // (проектный конфиг мержится после профиля).
  "agent": {
    "architect": { "model": "opencode-go/kimi-k3" },
    "planner": { "model": "opencode-go/kimi-k3" },
    "check": { "model": "opencode-go/kimi-k3" },
    "escalate": { "model": "opencode-go/kimi-k3" },
    "security-auditor": { "model": "opencode-go/kimi-k3" },
    "coder": { "model": "opencode-go/kimi-k3" },
    "scout": { "model": "opencode-go/kimi-k3" },
    "lane": { "model": "opencode-go/kimi-k3" }
  },
  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-gp"
    ]
  },
  "provider": {
    "opencode-go": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    },
    "openrouter": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      },
      "models": {
        "moonshotai/kimi-k2.6": {
          "limit": { "context": 262144, "output": 8192 }
        },
        "google/gemini-3.8-flash": {
          "limit": { "context": 1048576, "output": 8192 }
        }
      }
    }
  }
}
