{
  "$schema": "https://opencode.ai/config.json",
  // Вложенные субагенты (primary → pdca-orchestrator → роли). Дефолт 1 блокирует `pdca-orchestrator`. Нужен перезапуск.
  // V2: глубина живёт в `experimental.subagent_depth` — top-level `subagent_depth` V2 отбрасывает
  // с WARN (`omitted unsupported legacy setting`), и субагент теряет право делегировать (глубина = 1).
  "experimental": {
    "subagent_depth": 3
  },

  // ── Профиль oc-ds: обычная работа — дефолт-агент `build` (полные инструменты) ──
  // на cheap-тире; PDCA-цикл (.NET/C#) — общий скилл `pdca-dotnet` (решения PLAN `pdca-planner` и
  // Triage CHECK `pdca-check` — medium-тир, «руки»/сбор — cheap, `pdca-security-auditor` — medium,
  // `pdca-escalate` — strong). Субагенты целиком живут в общих `agents/*.md`.
  // Дефолт интерактивных сессий (`build`, `plan`, любые без явной привязки) — прямой DeepSeek
  // (`deepseek/deepseek-flash`: окно 1M / ответ ~393k), без подписки Go и без free-потолка zen
  // (окно 200k / ответ 32k). Роли на провайдере `opencode` (strong — Sonnet, Opus) идут
  // напрямую в Zen без локального прокси; Sol — через `openai` напрямую.
  "model": "deepseek/deepseek-flash",

  // Служебные задачи (заголовки/резюме) — тот же прямой DeepSeek: вызовы неинтерактивные,
  // падение человек не увидит.
  "small_model": "deepseek/deepseek-flash",

  // Обычный режим: стартуем в `build` (полные инструменты) — просто выполняем задачу.
  // Цикл PDCA не навязан: opencode сам показывает агенту список скиллов (name+description)
  // в system prompt, и `pdca-dotnet` грузится только когда пользователь просит
  // «по циклу»/«через PDCA». Отдельный instructions-файл не нужен.
  "default_agent": "build",

  // ── Привязка ролей к моделям (сами роли — в общих `agents/*.md`: только prompt/permission) ──
  // Тиры: cheap — прямой DeepSeek (`deepseek/deepseek-flash`, тот же id, что и дефолт сессии).
  // Исключение — кодовые роли `pdca-executor` и `coder` на бесплатной модели под Go
  // (`opencode-go/beam-free`, окно 1,05M, выход 131k): $0 и не расходуют платную квоту Go.
  // У free-пула общий дневной потолок (~2 000 запросов на обе роли, сброс в 00:00 UTC); когда
  // он выбран, zen-failover 0.3.0 сам записывает cap, переводит сессию и привязку на
  // `openai/gpt-6-luna` и по истечении срока возвращает Beam. Цель этого фолбэка задаёт
  // `ZEN_FAILOVER_RULES` в `oc-ds`/`pdca-fleet` (дефолт плагина — платный DeepSeek). У Luna
  // на подписке окно 272k и выход 128k (пик контекста executor'а: медиана 68–92k, p90
  // ~110–186k); если исчерпана и она, `openai` деградируется и сессия уходит на
  // `opencode/gpt-6-luna` (Console).
  // medium PLAN — Argon из подписки Go (`opencode-go/gemini-4-argon`, variant high); месячная
  // квота Go выбрана 04.11 (Console: renews 17.11, 18:24Z). Пока она не вернулась, первый же
  // 429 деградирует источник и planner идёт на `opencode/gemini-4-argon` (Console, платно,
  // ~$0.09 за прогон плана); срок деградации задаёт `ZEN_FAILOVER_RESET_OPENCODE_GO=14d` в
  // `oc-ds`/`pdca-fleet` (дефолт плагина — 7d, для месячного лимита это слишком рано), а точный
  // возврат — проба раз в 5 минут. medium CHECK
  // и SOL-роли — ChatGPT Plus (`openai/gpt-6.1-sol`, variant high, другое семейство для
  // независимого вердикта); strong — Sonnet (Console). Дефолт сессии — прямой DeepSeek.
  // Конкретные id — только здесь и в `model`/`small_model`;
  // в доках/ролях/скиллах — только тиры.
  // ВАЖНО: `~/.config/opencode/profiles/` — копия этого файла. Правь здесь и синхронизируй
  // (`cp config/profiles/deepseek.jsonc ~/.config/opencode/profiles/`): правка только в
  // installed-копии теряется при следующем sync (так уже откатился перевод Sol на OpenAI).
  "agent": {
    // PLAN — Argon из подписки Go: окно 1M, ответ 65k, `high` — потолок (xhigh/max нет).
    // Квота Go на модель — $30 (≈2 120 запросов), 5-часовое окно — 20 % от месячной; план жрёт
    // её в основном выходом (длинный текст плана), при исчерпании zen-failover уводит на
    // `opencode/gemini-4-argon` (платный zen).
    "pdca-planner": { "model": "opencode-go/gemini-4-argon", "variant": "high" },
    // CHECK — намеренно на другом семействе (Sol), чем `pdca-planner` (Gemini): независимый
    // вердикт. Идёт из ChatGPT Plus (`openai/…` — $0 маргинально); окно 1,05M покрывает реальные
    // проверки (пик по базе — 800k контекста). На платном zen тот же Sol дороже Argon'а, причём
    // с 272k контекста — по повышенному тарифу ($4/$15/$0,2 за 1M вместо $2/$10/$0,1), поэтому
    // падение подписки (zen-failover: `openai` → `opencode/gpt-6.1-sol`) дороже, но не смертельно.
    "pdca-check": { "model": "openai/gpt-6.1-sol", "variant": "high" },
    "pdca-escalate": { "model": "opencode/claude-sonnet-5-5" },
    "pdca-executor": { "model": "opencode-go/beam-free" },
    "architect": { "model": "openai/gpt-6.1-sol", "variant": "high" },
    "coder": { "model": "opencode-go/beam-free" },
    "scout": { "model": "deepseek/deepseek-flash" },
    "btw": { "model": "deepseek/deepseek-flash" },
    "pdca-orchestrator": { "model": "deepseek/deepseek-flash" }
  },

  // `pdca-dotnet` лежит в общем `~/.config/opencode/skills/` (built-in discovery, виден
  // всем профилям) — в paths указывать не нужно, только профильные наборы.
  // Профильный набор dotnet-скиллов — курируемый: регается только `skills-deepseek-curated`
  // (симлинки на выбранные скиллы из полного пака `skills-deepseek`). Что включено — см.
  // `~/.config/opencode/skills-keep.txt`; применить — `bun ~/.config/opencode/tools/curate-skills.mjs --fix`.
  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-deepseek-curated"
    ]
  },

  "provider": {
    "opencode": {
      "options": {
        // Рассуждающие (medium/strong-тир) модели долго «молчат» — запас больше.
        "headerTimeout": 60000,
        "chunkTimeout": 300000
        // baseURL на локальный zen-cache-proxy (127.0.0.1:8787) убран: после OAuth-логина
        // Console (27.10) запросы через прокси уходили без авторизации и upstream отвечал
        // 401 `Missing API key` — молча падал strong-тир (`pdca-escalate` на Sonnet).
        // Теперь провайдер идёт напрямую в Zen, OAuth прикладывается сам; цена — prompt-cache
        // Anthropic живёт 5 мин вместо часа, поэтому длинные паузы оркестратора дороже.
        // tools/zen-cache-proxy.mjs удалён из репо (вместе с запуском из алиаса oc-ds).
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    }
  },

  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "/home/alex/.bun/bin/bun",
        "x",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/home/alex/.local/share/opencode/memory.json"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "mslearn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs",
      "enabled": true
    }
  }
}
