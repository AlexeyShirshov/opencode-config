{
  "$schema": "https://opencode.ai/config.json",

  // ── Профиль oc-ds: обычная работа — дефолт-агент `build` (полные инструменты) ──
  // на DeepSeek Flash; PDCA-цикл (.NET/C#) — общий скилл `pdca-dotnet` (решения PLAN `planner` и
  // Triage CHECK `check` на GPT-6.1 Sol (variant high), «руки»/сбор — DeepSeek, `security-auditor` —
  // тоже Sol (medium), `escalate` — Sonnet). Субагенты целиком живут в общих `agents/*.md`.
  "model": "deepseek/deepseek-flash",

  // Дешёвая модель для служебных задач (генерация заголовков/резюме).
  "small_model": "deepseek/deepseek-flash",

  // Обычный режим: стартуем в `build` (полные инструменты) — просто выполняем задачу.
  // Цикл PDCA не навязан: opencode сам показывает агенту список скиллов (name+description)
  // в system prompt, и `pdca-dotnet` грузится только когда пользователь просит
  // «по циклу»/«через PDCA». Отдельный instructions-файл не нужен.
  "default_agent": "build",

  // ── Привязка ролей к моделям (сами роли — в общих `agents/*.md`: только prompt/permission) ──
  // Тиры: cheap = DeepSeek Flash (coder/scout/lane), medium = GPT-6.1 Sol (high), strong = Sonnet 5.5 (см. README).
  // Проект переопределяет любую роль своим `.opencode/opencode.jsonc` — проектный конфиг
  // мержится после профиля, достаточно указать только изменённые роли (например, `escalate`).
  "agent": {
    "architect": { "model": "opencode/gpt-6.1-sol", "variant": "high" },
    "planner": { "model": "opencode/gpt-6.1-sol", "variant": "high" },
    "check": { "model": "opencode/gpt-6.1-sol", "variant": "high" },
    "escalate": { "model": "opencode/claude-sonnet-5-5" },
    "security-auditor": { "model": "opencode/gpt-6.1-sol", "variant": "high" },
    "coder": { "model": "deepseek/deepseek-flash" },
    "scout": { "model": "deepseek/deepseek-flash" },
    "lane": { "model": "deepseek/deepseek-flash" }
  },

  // `pdca-dotnet` лежит в общем `~/.config/opencode/skills/` (built-in discovery, виден
  // всем профилям) — в paths указывать не нужно, только профильные наборы.
  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-deepseek"
    ]
  },

  "provider": {
    "opencode": {
      "options": {
        // Рассуждающие модели (Sonnet 5.5 / GPT-6 Sol) долго «молчат» — запас больше.
        "headerTimeout": 60000,
        "chunkTimeout": 300000,
        // Локальный zen-cache-proxy добавляет cache_control.ttl="1h" (иначе 5 мин):
        // оркестратор не теряет prompt-cache, пока ждёт субагентов → нет дорогих
        // перезаписей контекста. Поднимается из алиаса oc-ds;
        // см. tools/zen-cache-proxy.mjs.
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    }
  },

  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "/home/alex/.bun/bin/bun",
        "x",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/home/alex/.local/share/opencode/memory.json"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "mslearn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs",
      "enabled": true
    }
  }
}
