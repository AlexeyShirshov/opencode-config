{
  "$schema": "https://opencode.ai/config.json",
  // Вложенные субагенты (primary → pdca-orchestrator → роли). Дефолт 1 блокирует `pdca-orchestrator`. Нужен перезапуск.
  // V2: глубина живёт в `experimental.subagent_depth` — top-level `subagent_depth` V2 отбрасывает
  // с WARN (`omitted unsupported legacy setting`), и субагент теряет право делегировать (глубина = 1).
  "experimental": {
    "subagent_depth": 3
  },

  // ── Профиль oc-ds: обычная работа — дефолт-агент `build` (полные инструменты) ──
  // на cheap-тире; PDCA-цикл (.NET/C#) — общий скилл `pdca-dotnet` (решения PLAN `pdca-planner` и
  // Triage CHECK `pdca-check` — medium-тир, «руки»/сбор — cheap, `pdca-security-auditor` — medium,
  // `pdca-escalate` — strong). Субагенты целиком живут в общих `agents/*.md`.
  // Дефолт интерактивных сессий (`build`, `plan`, любые без явной привязки) — модель
  // Go-подписки: квота подписки вместо free-потолка zen (окно 200k / ответ 32k), поэтому
  // длинные сессии не упираются в free-лимит. zen-cache-proxy (127.0.0.1:8787) нужен
  // только ролям на провайдере `opencode` (CHECK/strong); Sol идёт через `openai` напрямую.
  "model": "opencode-go/deepseek-v4.1-flash",

  // Служебные задачи (заголовки/резюме) — прямой DeepSeek: вызовы неинтерактивные,
  // падение человек не увидит; квоту Go-подписки на них не тратим.
  "small_model": "deepseek/deepseek-flash",

  // Обычный режим: стартуем в `build` (полные инструменты) — просто выполняем задачу.
  // Цикл PDCA не навязан: opencode сам показывает агенту список скиллов (name+description)
  // в system prompt, и `pdca-dotnet` грузится только когда пользователь просит
  // «по циклу»/«через PDCA». Отдельный instructions-файл не нужен.
  "default_agent": "build",

  // ── Привязка ролей к моделям (сами роли — в общих `agents/*.md`: только prompt/permission) ──
  // Тиры: cheap — Go Plus (`opencode-go/deepseek-v4.1-flash`); medium SOL-роли — ChatGPT Plus
  // (`openai/gpt-6.1-sol`, variant high); CHECK — Argon (Console, другое семейство для
  // независимого вердикта); strong — Sonnet (Console). Конкретные id — только здесь и в
  // `model`/`small_model`; в доках/ролях/скиллах — только тиры.
  // ВАЖНО: `~/.config/opencode/profiles/` — копия этого файла. Правь здесь и синхронизируй
  // (`cp config/profiles/deepseek.jsonc ~/.config/opencode/profiles/`): правка только в
  // installed-копии теряется при следующем sync (так уже откатился перевод Sol на OpenAI).
  "agent": {
    "pdca-planner": { "model": "openai/gpt-6.1-sol", "variant": "high" },
    // CHECK — намеренно на другом семействе (Gemini 4 Argon), чем `pdca-planner` (Sol):
    // независимый вердикт. `high` — потолок у Argon (xhigh/max нет); замер: thinking ≈ 3× ответа,
    // 1.1k токенов выхода ≈ 1.7% лимита 65k, обрезки нет.
    "pdca-check": { "model": "opencode/gemini-4-argon", "variant": "high" },
    "pdca-escalate": { "model": "opencode/claude-sonnet-5-5" },
    "pdca-executor": { "model": "opencode-go/deepseek-v4.1-flash" },
    "architect": { "model": "openai/gpt-6.1-sol", "variant": "high" },
    "coder": { "model": "opencode-go/deepseek-v4.1-flash" },
    "scout": { "model": "opencode-go/deepseek-v4.1-flash" },
    "btw": { "model": "opencode-go/deepseek-v4.1-flash" },
    "pdca-orchestrator": { "model": "opencode-go/deepseek-v4.1-flash" }
  },

  // `pdca-dotnet` лежит в общем `~/.config/opencode/skills/` (built-in discovery, виден
  // всем профилям) — в paths указывать не нужно, только профильные наборы.
  // Профильный набор dotnet-скиллов — курируемый: регается только `skills-deepseek-curated`
  // (симлинки на выбранные скиллы из полного пака `skills-deepseek`). Что включено — см.
  // `~/.config/opencode/skills-keep.txt`; применить — `bun ~/.config/opencode/tools/curate-skills.mjs --fix`.
  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-deepseek-curated"
    ]
  },

  "provider": {
    "opencode": {
      "options": {
        // Рассуждающие (medium/strong-тир) модели долго «молчат» — запас больше.
        "headerTimeout": 60000,
        "chunkTimeout": 300000,
        // Локальный zen-cache-proxy добавляет cache_control.ttl="1h" (иначе 5 мин):
        // оркестратор не теряет prompt-cache, пока ждёт субагентов → нет дорогих
        // перезаписей контекста. Поднимается из алиаса oc-ds;
        // см. tools/zen-cache-proxy.mjs.
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    }
  },

  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "/home/alex/.bun/bin/bun",
        "x",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/home/alex/.local/share/opencode/memory.json"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "mslearn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs",
      "enabled": true
    }
  }
}
