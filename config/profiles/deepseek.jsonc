{
  "$schema": "https://opencode.ai/config.json",
  // Вложенные субагенты (primary → pdca-orchestrator → роли). Дефолт 1 блокирует `pdca-orchestrator`. Нужен перезапуск.
  // V2: глубина живёт в `experimental.subagent_depth` — top-level `subagent_depth` V2 отбрасывает
  // с WARN (`omitted unsupported legacy setting`), и субагент теряет право делегировать (глубина = 1).
  "experimental": {
    "subagent_depth": 3
  },

  // ── Профиль oc-ds: обычная работа — дефолт-агент `build` (полные инструменты) ──
  // PDCA-цикл (.NET/C#) — общий скилл `pdca-dotnet`
  // (решения PLAN `pdca-planner` и Triage CHECK `pdca-check` — medium-тир, «руки»/сбор — cheap,
  // `pdca-security-auditor` — medium, `pdca-escalate` — strong). Субагенты целиком живут
  // в общих `agents/*.md`.
  // Дефолт интерактивных сессий и агентов без привязки — бесплатный Beam.
  "model": "opencode-go/beam-free",

  // Служебные задачи (заголовки/резюме) — Luna: вызовы неинтерактивные, поэтому самая
  // дешёвая по квоте модель подписки.
  "small_model": "openai/gpt-6-luna",

  // Обычный режим: стартуем в `build` (полные инструменты) — просто выполняем задачу.
  // Цикл PDCA не навязан: opencode сам показывает агенту список скиллов (name+description)
  // в system prompt, и `pdca-dotnet` грузится только когда пользователь просит
  // «по циклу»/«через PDCA». Отдельный instructions-файл не нужен.
  "default_agent": "build",

  // ── Привязка ролей к моделям (сами роли — в общих `agents/*.md`: только prompt/permission) ──
  // PLAN и escalation идут через Console, CHECK и cheap-роли — через ChatGPT.
  // Beam ограничен дневной квотой; цель fallback зависит от правил zen-failover.
  // При квотной ошибке openai zen-failover может переключить на платный Console;
  // истечение токена (401) само по себе такого переключения не гарантирует.
  // Конкретные id — только здесь и в `model`/`small_model`;
  // в доках/ролях/скиллах — только тиры.
  // ВАЖНО: `~/.config/opencode/profiles/` — копия этого файла. Правь здесь и синхронизируй
  // (`bun config/tools/sync-profiles.mjs --fix`): правка только в installed-копии
  // теряется при следующем sync.
  "agent": {
    "pdca-planner": { "model": "opencode/gemini-4-argon" },
    // CHECK — Sol high: окно 1,05M покрывает реальные проверки (пик по базе — 800k контекста).
    "pdca-check": { "model": "openai/gpt-6.1-sol", "variant": "high" },
    "pdca-escalate": { "model": "opencode/claude-sonnet-5-5" },
    "pdca-executor": { "model": "openai/gpt-6-luna", "variant": "xhigh" },
    "architect": { "model": "openai/gpt-6-astra" },
    "coder": { "model": "openai/gpt-6-luna" },
    "scout": { "model": "openai/gpt-6-luna" },
    "btw": { "model": "openai/gpt-6-luna" },
    "pdca-orchestrator": { "model": "openai/gpt-6-luna" }
  },

  // `pdca-dotnet` лежит в общем `~/.config/opencode/skills/` (built-in discovery, виден
  // всем профилям) — в paths указывать не нужно, только профильные наборы.
  // Профильный набор dotnet-скиллов — курируемый: регается только `skills-deepseek-curated`
  // (симлинки на выбранные скиллы из полного пака `skills-deepseek`). Что включено — см.
  // `~/.config/opencode/skills-keep.txt`; применить — `bun ~/.config/opencode/tools/curate-skills.mjs --fix`.
  "skills": {
    "paths": [
      "/home/alex/.config/opencode/skills-deepseek-curated"
    ]
  },

  "provider": {
    "opencode": {
      "options": {
        // Рассуждающие (medium/strong-тир) модели долго «молчат» — запас больше.
        "headerTimeout": 60000,
        "chunkTimeout": 300000
        // baseURL на локальный zen-cache-proxy (127.0.0.1:8787) убран: после OAuth-логина
        // Console (27.10) запросы через прокси уходили без авторизации и upstream отвечал
        // 401 `Missing API key` — молча падал strong-тир (`pdca-escalate` на Sonnet).
        // Теперь провайдер идёт напрямую в Zen, OAuth прикладывается сам; цена — prompt-cache
        // Anthropic живёт 5 мин вместо часа, поэтому длинные паузы оркестратора дороже.
        // tools/zen-cache-proxy.mjs удалён из репо (вместе с запуском из алиаса oc-ds).
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "headerTimeout": 60000,
        "chunkTimeout": 180000
      }
    },
    // ChatGPT-подписка используется для части ролей. Sol на проверках
    // молчит долго, Luna — на больших диффах; запас по таймаутам как у прежних источников.
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 300000
      }
    }
  },

  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "/home/alex/.bun/bin/bun",
        "x",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/home/alex/.local/share/opencode/memory.json"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "mslearn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs",
      "enabled": true
    }
  }
}
